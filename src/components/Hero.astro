---
import {
  HEADER_CTA,
  FREE_TOOLS_LINK,
  HERO_OFFER_LINE,
  HERO_AVAILABILITY_NOTE,
  STATUS_EXAMPLE,
} from "../data/site";
---

<section class="relative overflow-hidden pt-10 pb-8 sm:pt-14 sm:pb-[2.875rem] lg:pt-16 lg:pb-[3.25rem]">
  <div class="content-shell grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div data-animate>
      <p class="eyebrow">Painting estimating software for independent painters</p>
      <h1 class="mt-4 text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-5xl">
        <span>Know your costs.</span> <span class="block">Protect your margin.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
        Finishing a job shouldn't be the first time you discover what it
        leaves. Painting Estimate Pro is being built to help you review
        materials, labor, overhead, and estimated job profit before
        sending your quote.
      </p>

      <div class="mt-8">
        <a href={HEADER_CTA.href} class="btn btn-primary">{HEADER_CTA.label}</a>
      </div>

      <a href={FREE_TOOLS_LINK.href} class="text-link mt-4 inline-block text-sm">
        {FREE_TOOLS_LINK.label}
      </a>

      <p class="mt-5 text-sm font-medium text-ink-soft">{HERO_OFFER_LINE}</p>

      <p class="status-note mt-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {HERO_AVAILABILITY_NOTE}
      </p>
    </div>

    <div data-animate class="relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="card relative overflow-hidden p-6 shadow-[0_1px_2px_rgba(23,33,29,0.04),0_12px_32px_-16px_rgba(23,33,29,0.18)] sm:p-7">
        <div class="flex items-start justify-between gap-3">
          <p class="text-base font-semibold leading-snug text-ink">
            What does an $85 door price leave?
          </p>
          <span class="tag-preview shrink-0">{STATUS_EXAMPLE}</span>
        </div>

        <dl class="mt-6 space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-ink-soft">Price per door</dt>
            <dd class="tabular-nums font-medium text-ink">$85</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-ink-soft">Estimated cost per door</dt>
            <dd class="tabular-nums font-medium text-ink">$67</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-ink-soft">Estimated profit per door</dt>
            <dd class="tabular-nums font-medium text-ink">$18</dd>
          </div>
        </dl>

        <div class="mt-5 rounded-[calc(var(--radius-card)-8px)] border border-warn-line bg-warn-soft p-4">
          <p class="tabular-nums text-2xl font-semibold text-warn">21.2% estimated margin</p>
          <p class="mt-0.5 text-sm font-medium text-ink-soft">Sample target: 35%</p>

          <div
            class="mt-3 margin-bar-track"
            role="img"
            aria-label="Estimated margin 21.2 percent, compared with a 35 percent sample target"
          >
            <div class="margin-bar-fill" style="width: 42.4%;"></div>
            <div class="margin-bar-target" style="left: 70%;"></div>
          </div>
          <div class="mt-1.5 flex items-center justify-between text-[0.6875rem] font-medium text-ink-soft">
            <span>0%</span>
            <span>35% target</span>
          </div>
        </div>

        <div class="mt-5 border-t border-line pt-4">
          <p class="text-sm font-medium text-ink-soft">Price to reach the sample margin target</p>
          <p class="mt-1 tabular-nums text-lg font-semibold text-primary-dark">About $103.08 / door</p>
          <p class="mt-2 text-xs leading-relaxed text-ink-soft">
            Assumes the same $67 cost. Illustrative figures, not suggested
            market rates.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
