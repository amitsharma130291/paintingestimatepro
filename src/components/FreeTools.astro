---
import { STATUS_COMING_SOON } from "../data/site";

// Only link a card once the tool is genuinely implemented and live at that
// route — never mark something "available" ahead of the real functionality.
const TOOLS = [
  {
    title: "Interior painting cost calculator",
    description: "Plan the cost of walls, ceilings, trim, and labor.",
    icon: "roller",
    href: "/free/interior-calculator",
  },
  {
    title: "Exterior painting cost calculator",
    description: "Break down exterior surfaces, materials, and labor.",
    icon: "house",
    href: null,
  },
  {
    title: "Paint quantity calculator",
    description: "Estimate paint needs from surface area, coats, and coverage.",
    icon: "droplet",
    href: null,
  },
  {
    title: "Painting estimate template",
    description: "Present a clear breakdown of the work and price.",
    icon: "document",
    href: "/free/estimate-template",
  },
  {
    title: "Painting job cost calculator",
    description: "Bring labor, materials, and overhead into one view.",
    icon: "layers",
    href: "/free/job-cost-calculator",
  },
  {
    title: "Painting invoice template",
    description: "Present completed work in a straightforward invoice.",
    icon: "receipt",
    href: null,
  },
] as const;

const ICON_PATHS: Record<string, string> = {
  roller:
    '<rect x="3" y="4" width="12" height="6" rx="1.5"></rect><path d="M7 10v3a2 2 0 0 0 2 2h1"></path><rect x="9" y="15" width="5" height="6" rx="1"></rect>',
  house:
    '<path d="M4 11.5 12 4l8 7.5"></path><path d="M6 10v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9"></path><path d="M10 20v-5h4v5"></path>',
  droplet:
    '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"></path>',
  document:
    '<path d="M7 3h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"></path><path d="M14 3v4h4"></path><path d="M9 13h6"></path><path d="M9 17h6"></path>',
  layers:
    '<path d="m12 3 9 5-9 5-9-5 9-5Z"></path><path d="m3 13 9 5 9-5"></path>',
  receipt:
    '<path d="M6 3h12v18l-3-2-2 2-2-2-2 2-3-2Z"></path><path d="M9 8h6"></path><path d="M9 12h6"></path>',
};
---

<section id="free-tools" class="section-pad scroll-mt-16">
  <div class="content-shell">
    <div data-animate class="max-w-2xl">
      <h2 class="text-balance text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        Free painting calculators and templates
      </h2>
      <p class="mt-3 text-base text-ink-soft">
        Explore the free tools planned for painting costs, paint
        quantities, estimates, and invoices. Pro will bring reusable
        rates, job costs, and margin review into one workflow.
      </p>
    </div>

    <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOOLS.map((tool, i) => {
          const Wrapper = tool.href ? "a" : "div";
          return (
            <Wrapper
              data-animate
              style={`transition-delay:${Math.min(i, 3) * 60}ms`}
              href={tool.href ?? undefined}
              class={`card flex flex-col gap-3 p-5 transition-colors duration-200 ${tool.href ? "hover:border-primary/50" : "hover:border-primary/40"}`}
            >
              <div class="flex items-start justify-between gap-3">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-[calc(var(--radius-card)-10px)] bg-primary/[0.08] text-primary-dark">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={ICON_PATHS[tool.icon]}
                  />
                </span>
                {tool.href ? (
                  <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary-dark">
                    Try it now
                  </span>
                ) : (
                  <span class="status-pill">{STATUS_COMING_SOON}</span>
                )}
              </div>
              <div>
                <h3 class="text-sm font-semibold text-ink">{tool.title}</h3>
                <p class="mt-1 text-xs leading-relaxed text-ink-soft">
                  {tool.description}
                </p>
              </div>
            </Wrapper>
          );
        })
      }
    </div>
  </div>
</section>
