---
import { PRICE, PRICING_AVAILABILITY_NOTE, PRICING_FAQ_LINK } from "../data/site";
import LicenseActions from "./tools/LicenseActions.tsx";

const FEATURES = [
  "Reusable labor, material, and service rates.",
  "Room and surface estimates with overhead.",
  "Target-margin review and Price Book Health.",
  "Professional estimate output and estimate-versus-actual review.",
];
---

<section id="pricing" class="section-pad scroll-mt-16 pt-[1.875rem] sm:pt-[2.875rem] lg:pt-[3.625rem]">
  <div class="content-shell">
    <div data-animate class="card mx-auto max-w-3xl p-8 sm:p-10">
      <div class="text-center">
        <p class="eyebrow justify-center">Launch price</p>
        <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          A repeatable way to review every quote.
        </h2>

        <p class="mx-auto mt-4 max-w-xl text-base text-ink-soft">
          For independent painters and small painting businesses that want
          focused estimating tools without a full management platform.
        </p>

        <div class="mt-6 flex items-baseline justify-center gap-3">
          <span class="tabular-nums text-2xl font-medium text-ink-soft/70 line-through">{PRICE.originalAmount}</span>
          <span class="tabular-nums text-5xl font-semibold text-ink">{PRICE.amount}</span>
        </div>
        <p class="mt-2 text-sm font-medium text-ink-soft">{PRICE.caption}</p>
        <p class="mt-1 status-pill status-pill-brass inline-flex">Launch price — save $20</p>
      </div>

      <ul class="mx-auto mt-8 grid max-w-xl grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          FEATURES.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm text-ink">
              <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-9 flex flex-col items-center gap-3 text-center">
        <LicenseActions client:load returnTo="/app" />
        <a href={PRICING_FAQ_LINK.href} class="text-link mt-2 text-sm">
          {PRICING_FAQ_LINK.label}
        </a>
        <a href="/help" class="text-link text-sm">
          See exactly what's inside, with screenshots
        </a>
        <a href="/painting-estimating-software" class="text-link text-sm">
          What is painting estimating software?
        </a>
        <a href="/pricing" class="text-link text-sm">
          See the full pricing page — walkthrough, guarantee, and FAQ
        </a>
        <p class="status-note">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
          </svg>
          {PRICING_AVAILABILITY_NOTE}
        </p>
      </div>
    </div>
  </div>
</section>
