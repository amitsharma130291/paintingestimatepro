---
import { REFUND_GUARANTEE_DAYS, PRICE } from "../data/site";
import LicenseActions from "./tools/LicenseActions.tsx";

const POINTS = [
  "Complete product access",
  `${REFUND_GUARANTEE_DAYS} days to evaluate it`,
  "One-time payment",
  "No monthly subscription",
];
---

<section id="guarantee" class="section-pad scroll-mt-16 border-t border-line" data-analytics-view="guarantee_viewed">
  <div class="content-shell">
    <div data-animate class="card mx-auto max-w-2xl p-8 text-center sm:p-10">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-surface-sage text-primary-dark">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
          <polyline points="9 12 11 14 15 10" />
        </svg>
      </span>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        A new, focused product — with a straightforward guarantee.
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-ink-soft">
        Painting Estimate Pro is a new, independent product built for
        contractors who want better control over job costs without paying
        every month for a large contractor-management platform. You
        shouldn't have to rely on popularity claims — the walkthrough above
        shows the real product. Use the complete workspace with your own
        estimating process, and if it's not a good fit, request a refund
        within {REFUND_GUARANTEE_DAYS} days.
      </p>

      <ul class="mx-auto mt-5 flex max-w-md flex-wrap items-center justify-center gap-x-5 gap-y-1.5">
        {
          POINTS.map((point) => (
            <li class="flex items-center gap-1.5 text-sm text-ink-soft">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>

      <div class="mt-6 flex flex-col items-center gap-2">
        <LicenseActions client:load returnTo="/app" buyLabel={`Try Painting Estimate Pro — ${PRICE.amount}`} />
      </div>

      <a href="/terms" class="text-link mt-3 inline-block text-sm">Read the refund terms</a>
    </div>
  </div>
</section>
