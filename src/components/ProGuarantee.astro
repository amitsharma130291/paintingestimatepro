---
import { REFUND_GUARANTEE_DAYS, PRICE } from "../data/site";
import LicenseActions from "./tools/LicenseActions.tsx";
---

<section id="guarantee" class="section-pad scroll-mt-16 border-t border-line">
  <div class="content-shell">
    <div data-animate class="card mx-auto flex max-w-2xl flex-col items-center gap-3 p-8 text-center sm:p-10">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-surface-sage text-primary-dark">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
          <polyline points="9 12 11 14 15 10" />
        </svg>
      </span>
      <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        Try the complete product for {REFUND_GUARANTEE_DAYS} days.
      </h2>
      <p class="max-w-md text-base leading-relaxed text-ink-soft">
        Purchase Painting Estimate Pro and use the full workspace with your
        own estimating process. If it's not a good fit, request a refund
        within {REFUND_GUARANTEE_DAYS} days — just email us with the
        address you paid with. Your local project data is never touched
        either way.
      </p>

      <div class="mt-3 flex flex-col items-center gap-2">
        <LicenseActions client:load returnTo="/app" buyLabel={`Try Painting Estimate Pro — ${PRICE.amount}`} />
        <p class="text-sm text-ink-soft">One payment. No subscription.</p>
      </div>

      <a href="/terms" class="text-link mt-2 text-sm">Read the full refund policy</a>
    </div>
  </div>
</section>
