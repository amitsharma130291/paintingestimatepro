---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <svg
    width="26"
    height="26"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect x="0.5" y="0.5" width="31" height="31" rx="9" fill="var(--color-primary)" />
    <path
      d="M9 20.5c0-5 3.2-9 7-9s7 4 7 9-3.2 3.5-7 3.5-7 1.5-7-3.5Z"
      fill="var(--color-primary-ink)"
    />
    <circle cx="13" cy="14" r="2.1" fill="#F5C56B" />
  </svg>
  <span class="font-semibold tracking-tight text-[1.05rem] text-ink">
    Painting Estimate Pro
  </span>
</span>
