---
import { STATUS_EXAMPLE, PRICE } from "../data/site";

const ROWS = [
  { label: "Original quote", value: "$4,800" },
  { label: "Expected job cost", value: "$3,600" },
  { label: "Expected profit", value: "$1,200", strong: true },
  { label: "Overlooked labor and overhead", value: "$340", warn: true },
  { label: "Corrected job cost", value: "$3,940" },
  { label: "Corrected expected profit", value: "$860", strong: true },
];
---

<section class="section-pad border-t border-line" data-analytics-view="roi_section_viewed">
  <div class="content-shell">
    <div class="mx-auto max-w-2xl">
      <h2 data-animate class="text-balance text-center text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        One missed cost can be worth more than the price of Pro.
      </h2>

      <div data-animate class="card mt-8 p-6 sm:p-7">
        <span class="tag-preview">{STATUS_EXAMPLE}</span>
        <dl class="mt-4 space-y-2 text-base">
          {
            ROWS.map((row) => (
              <div class={`flex items-center justify-between ${row.warn ? "rounded-btn bg-warn-soft px-3 py-1.5" : ""}`}>
                <dt class={row.warn ? "font-medium text-warn" : "text-ink-soft"}>{row.label}</dt>
                <dd class={`tabular-nums ${row.strong ? "font-semibold text-ink" : row.warn ? "font-semibold text-warn" : "text-ink"}`}>{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-6 grid grid-cols-1 gap-4 border-t border-line pt-6 text-center sm:grid-cols-2">
          <div>
            <p class="tabular-nums text-4xl font-bold text-primary-dark sm:text-5xl">$340</p>
            <p class="mt-1 text-sm font-medium text-ink-soft">in costs caught before quoting</p>
          </div>
          <div>
            <p class="tabular-nums text-4xl font-bold text-ink sm:text-5xl">{PRICE.amount}</p>
            <p class="mt-1 text-sm font-medium text-ink-soft">Painting Estimate Pro, once</p>
          </div>
        </div>
      </div>

      <p data-animate class="mx-auto mt-5 max-w-lg text-center text-base leading-relaxed text-ink">
        Pro does not need to rescue every estimate to justify its price.
      </p>
      <p data-animate class="mt-1.5 text-center text-xs text-ink-soft">
        Illustrative example only. Your jobs, costs, and results will vary.
      </p>
    </div>
  </div>
</section>
