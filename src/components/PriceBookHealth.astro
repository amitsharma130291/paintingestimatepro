---
import {
  STATUS_PREVIEW,
  TARGET_MARGIN,
  PRICE_BOOK_TO_PRICING_LINK,
  PRICE_BOOK_SAMPLE_ROWS as PRICE_ROWS,
  PRICE_BOOK_SAMPLE_INTRO,
  PRICE_BOOK_SAMPLE_CALLOUT_HEADING,
  PRICE_BOOK_SAMPLE_CALLOUT_BODY,
  PRICE_BOOK_SAMPLE_FOOTNOTE,
} from "../data/site";
---

<section id="price-book-health" class="section-pad scroll-mt-16">
  <div class="content-shell">
    <div data-animate class="max-w-2xl">
      <h2 class="text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        See which rates deserve a second look.
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        {PRICE_BOOK_SAMPLE_INTRO}
      </p>
    </div>

    <div data-animate class="card mt-9 overflow-hidden p-6 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-lg font-semibold text-ink">Price Book Health</h3>
        <span class="tag-preview">
          {STATUS_PREVIEW} · Sample target margin: {TARGET_MARGIN}
        </span>
      </div>

      <!-- Table layout: sm and up -->
      <div class="mt-5 hidden overflow-x-auto sm:block">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-line text-left text-xs uppercase tracking-wide text-ink-soft">
              <th scope="col" class="py-2.5 pr-4 font-medium">Service</th>
              <th scope="col" class="py-2.5 pr-4 font-medium">Current price</th>
              <th scope="col" class="py-2.5 pr-4 font-medium">Estimated margin</th>
              <th scope="col" class="py-2.5 pr-4 font-medium">Status</th>
            </tr>
          </thead>
          <tbody>
            {
              PRICE_ROWS.map((row) => (
                <tr
                  data-animate-emphasis={row.flag ? true : undefined}
                  class="border-b border-line-soft last:border-0"
                >
                  <td class={`py-3 pr-4 pl-3 font-medium text-ink ${row.flag ? "border-l-2 border-l-warn" : ""}`}>{row.service}</td>
                  <td class="py-3 pr-4 tabular-nums text-ink-soft">{row.price}</td>
                  <td class="py-3 pr-4 tabular-nums text-ink-soft">{row.margin}</td>
                  <td class="py-3 pr-4">
                    {row.status === "Above target" ? (
                      <span class="status-quiet">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                        {row.status}
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1.5 rounded-full bg-warn-soft px-2.5 py-1 text-xs font-semibold text-warn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg>
                        {row.status}
                      </span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- Card layout: below sm -->
      <div class="mt-5 space-y-3 sm:hidden">
        {
          PRICE_ROWS.map((row) => (
            <div
              data-animate-emphasis={row.flag ? true : undefined}
              class={`rounded-[calc(var(--radius-card)-8px)] border p-4 ${row.flag ? "border-warn-line" : "border-line-soft"}`}
            >
              <div class="flex items-center justify-between">
                <span class="font-semibold text-ink">{row.service}</span>
                {row.status === "Above target" ? (
                  <span class="status-quiet">{row.status}</span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-warn-soft px-2.5 py-1 text-xs font-semibold text-warn">
                    {row.status}
                  </span>
                )}
              </div>
              <dl class="mt-2 grid grid-cols-2 gap-1 text-sm">
                <dt class="text-ink-soft">Current price</dt>
                <dd class="text-right tabular-nums text-ink">{row.price}</dd>
                <dt class="text-ink-soft">Estimated margin</dt>
                <dd class="text-right tabular-nums text-ink">{row.margin}</dd>
              </dl>
            </div>
          ))
        }
      </div>

      <div class="mt-6 rounded-[calc(var(--radius-card)-8px)] border border-warn-line bg-warn-soft/60 p-4 sm:p-5">
        <p class="text-sm font-semibold text-ink">{PRICE_BOOK_SAMPLE_CALLOUT_HEADING}</p>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
          {PRICE_BOOK_SAMPLE_CALLOUT_BODY}
        </p>
      </div>

      <p class="mt-5 text-xs leading-relaxed text-ink-soft">
        {PRICE_BOOK_SAMPLE_FOOTNOTE}
      </p>
    </div>

    <p data-animate class="mt-6 text-center">
      <a href={PRICE_BOOK_TO_PRICING_LINK.href} class="text-link text-sm">
        {PRICE_BOOK_TO_PRICING_LINK.label}
      </a>
    </p>
  </div>
</section>
