---
import Logo from "./Logo.astro";
import { NAV_LINKS } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10">
  <div class="content-shell flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">
        Painting tools for clearer costs and more confident estimates.
      </p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-sm text-ink-soft transition-colors duration-150 hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="content-shell mt-8 flex flex-col gap-3 border-t border-line-soft pt-6 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-ink-soft">
      &copy; {year} PaintingPricing Calculator. All rights reserved.
    </p>
    <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-1">
      <a href="/privacy" class="text-sm text-ink-soft transition-colors duration-150 hover:text-ink">
        Privacy Policy
      </a>
      <a href="/terms" class="text-sm text-ink-soft transition-colors duration-150 hover:text-ink">
        Terms of Service
      </a>
      <a href="/disclaimer" class="text-sm text-ink-soft transition-colors duration-150 hover:text-ink">
        Disclaimer
      </a>
    </nav>
  </div>
</footer>
