---
import { BUY_CTA_LABEL } from "../data/site";
import ProWalkthrough from "./tools/ProWalkthrough.tsx";

// Four steps, each a real screenshot of the actual app (captured via
// Playwright driving the real ProApp component). The cost and margin
// crops are two halves of the SAME Estimate summary card -- the real UI
// shows cost breakdown directly above the price/margin result -- not two
// separate claims stitched together. No genuine screen recording exists,
// so this stays the "compact interactive walkthrough" fallback the brief
// asks for instead of fabricating a video -- see ProWalkthrough.tsx.
const STEPS = [
  {
    heading: "Build the job",
    body: "Enter the project, its rooms and surfaces, the paint you're using, and any expected extra costs.",
    image: "/guide/project-rooms.webp",
    alt: "A room editor showing a room's dimensions, door and window deductions, and its Wall surface with a paint variant selected",
    width: 846,
    height: 639,
  },
  {
    heading: "Check the true cost",
    body: "Materials, labor, direct cost, and overhead roll up into one estimated job cost — no separate spreadsheet to reconcile.",
    image: "/guide/estimate-cost.webp",
    alt: "The Estimate summary's cost breakdown: Materials, Labor, Direct cost, Overhead, and Estimated job cost",
    width: 836,
    height: 232,
  },
  {
    heading: "Protect the margin",
    body: "Set your target margin and see the selling price it actually requires — profit and margin, before you send anything.",
    image: "/guide/estimate-margin.webp",
    alt: "The proposed price, profit, and margin with an 'Above target' status badge",
    width: 836,
    height: 208,
  },
  {
    heading: "Compare estimate with actual",
    body: "Once the job's done, record what it really cost. Pro shows you which assumptions held up and which missed.",
    image: "/guide/actual-review.webp",
    alt: "The Actual Costs tab with Materials, Labor, Other Expenses, and Overhead confirmed, showing Actual cost, Profit vs. original quote, Margin, and Total variance",
    width: 1200,
    height: 1144,
  },
];
---

<section id="demo" class="section-pad scroll-mt-16 border-t border-line">
  <div class="content-shell">
    <div data-animate class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl">See exactly how it works.</h2>
      <p class="mt-3 text-lg text-ink-soft">Follow one painting job from the first cost assumption to the final margin check.</p>
    </div>

    <div data-animate class="mx-auto mt-10 max-w-4xl">
      <ProWalkthrough client:load steps={STEPS} />
      <p class="mt-3 text-center text-sm text-ink-soft">
        Use the arrow keys, swipe, or the buttons below to step through.
      </p>
    </div>

    <div data-animate class="mt-10 flex flex-col items-center gap-2 text-center">
      <a href="#pricing" data-analytics-event="workflow_cta_clicked" class="btn btn-primary">{BUY_CTA_LABEL}</a>
    </div>
  </div>
</section>
