---
import { BUY_CTA_LABEL } from "../data/site";

// Combines the brief's "show the workflow" and "product demonstration"
// sections into one walkthrough -- a separate demo gallery right after
// this one would just show several of the same screens again. Every step
// is a real screenshot of the actual app (captured via Playwright driving
// the real ProApp component), not a mockup or an illustration.
const STEPS = [
  {
    step: "1",
    heading: "Create the project",
    body: "Start a new project in seconds — no account, no setup wizard. Add your customer's name and job-site address as you go; it flows straight onto the estimate later.",
    image: "/guide/projects-empty.png",
    alt: "The Projects tab with a '+ New project' button and a note that project data is stored only in this browser",
  },
  {
    step: "2",
    heading: "Add rooms, surfaces, and materials",
    body: "Enter each room's dimensions and pick a paint from your catalog. Pro works out the wall area, coats, and waste automatically — you never hand-calculate labor hours or paint quantity.",
    image: "/guide/project-rooms.png",
    alt: "A room editor showing a 16 by 13 by 9 foot room with door and window deductions, and its auto-created Wall surface with a paint variant selected",
  },
  {
    step: "3",
    heading: "Set your rates and overhead once",
    body: "Your loaded hourly rate, overhead ratio, and target margin, entered a single time. Every new project starts from these — you're not re-typing your business assumptions on every job.",
    image: "/guide/business-settings.png",
    alt: "The Business Settings tab showing loaded hourly rate, overhead, target margin, and per-surface throughput fields",
  },
  {
    step: "4",
    heading: "Choose your margin, see the calculated quote",
    body: "Materials, labor, direct cost, and overhead roll up automatically. Pick a suggested price at your target margin or set your own — profit and margin update live, before you send anything.",
    image: "/guide/estimate-summary.png",
    alt: "The Estimate summary card showing Materials, Labor, Direct cost, Overhead, Estimated job cost, and a Proposed price with Profit, Margin, and an 'Above target' status badge",
  },
  {
    step: "5",
    heading: "Produce a clean customer estimate",
    body: "A print-ready, customer-facing document — ready to print or save as a PDF. No cost, overhead, or margin figures ever appear on it, by design.",
    image: "/guide/customer-document.png",
    alt: "The customer-facing document: business info, project title, customer name, an estimate number and date, a line item, and a total price",
  },
  {
    step: "6",
    heading: "Record actual costs and compare",
    body: "Once the job's done, log what it really cost. Pro compares it to what you quoted — real profit, real margin, real variance — so you find out where an assumption held up or missed.",
    image: "/guide/actual-review.png",
    alt: "The Actual Costs tab with Materials, Labor, Other Expenses, and Overhead confirmed, showing Actual cost, Profit vs. original quote, Margin, and Total variance",
  },
];
---

<section id="demo" class="section-pad scroll-mt-16 border-t border-line">
  <div class="content-shell">
    <div data-animate class="mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center">See exactly what you're buying</p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        From measurements to margin — in one real workflow.
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        Painting Estimate Pro is new, so this isn't a highlight reel — it's
        one realistic job, start to finish, in the actual application.
      </p>
    </div>

    <ol class="mt-14 flex flex-col gap-16 sm:gap-20">
      {
        STEPS.map((item, i) => (
          <li
            data-animate
            class={`grid grid-cols-1 items-center gap-8 sm:gap-12 lg:grid-cols-2 lg:gap-16 ${i % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}`}
          >
            <div class="rounded-card border border-line shadow-[0_1px_2px_rgba(23,33,29,0.04),0_16px_40px_-20px_rgba(23,33,29,0.22)]">
              <img src={item.image} alt={item.alt} width="1200" height="1144" loading="lazy" class="w-full rounded-card" />
            </div>
            <div class="mx-auto max-w-md lg:mx-0">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-ink">
                {item.step}
              </span>
              <h3 class="mt-4 text-balance text-2xl font-semibold tracking-tight text-ink">{item.heading}</h3>
              <p class="mt-3 text-base leading-relaxed text-ink-soft">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div data-animate class="mt-14 flex flex-col items-center gap-3 text-center">
      <a href="#pricing" class="btn btn-primary">{BUY_CTA_LABEL}</a>
      <p class="text-sm text-ink-soft">One-time payment. No subscription.</p>
    </div>
  </div>
</section>
