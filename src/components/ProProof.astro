---
const SHOWCASE = [
  {
    heading: "One screen, the whole business.",
    body: "Active projects, estimates issued this month, estimated revenue, and your average margin — the moment you open Pro, before you dig into any single job.",
    image: "/guide/overview.png",
    alt: "The Overview dashboard showing active projects, estimated revenue, average margin, and a recent-projects table",
  },
  {
    heading: "Catch the rate that's quietly losing money.",
    body: "Price Book Health checks your own standing prices against their real modeled cost — so a rate you've charged for years, that's slipped below target as your costs changed, gets flagged before it costs you on the next ten jobs that use it.",
    image: "/guide/price-book-health.png",
    alt: "A Price Book Health service card showing modeled cost per unit, current price, status 'Above target', margin, and required price for target margin",
  },
  {
    heading: "Find out if your bids actually held up.",
    body: "Record what a finished job really cost — materials, labor, overhead — and Pro compares it to what you quoted: real profit, real margin, real variance. Not a guess about whether your rates work. An answer.",
    image: "/guide/actual-review.png",
    alt: "The Actual Costs tab showing Materials, Labor, Other Expenses, and Overhead confirmed, with Actual cost, Profit vs. original quote, Margin, and Total variance",
  },
];
---

<section id="proof" class="section-pad scroll-mt-16 border-t border-line">
  <div class="content-shell">
    <div data-animate class="mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center">See it, don't just take our word for it</p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        The actual workspace, not a mockup.
      </h2>
    </div>

    <div class="mt-14 flex flex-col gap-16 sm:gap-20">
      {
        SHOWCASE.map((item, i) => (
          <div
            data-animate
            class={`grid grid-cols-1 items-center gap-8 sm:gap-12 lg:grid-cols-2 lg:gap-16 ${i % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}`}
          >
            <div class="rounded-card border border-line shadow-[0_1px_2px_rgba(23,33,29,0.04),0_16px_40px_-20px_rgba(23,33,29,0.22)]">
              <img
                src={item.image}
                alt={item.alt}
                width="1200"
                height="1144"
                loading="lazy"
                class="w-full rounded-card"
              />
            </div>
            <div class="mx-auto max-w-md lg:mx-0">
              <h3 class="text-balance text-2xl font-semibold tracking-tight text-ink">{item.heading}</h3>
              <p class="mt-3 text-base leading-relaxed text-ink-soft">{item.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
