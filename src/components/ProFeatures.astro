---
import { PRICE, BUY_CTA_LABEL } from "../data/site";

// Every line here is a real, working feature -- verified against the
// actual ProApp implementation, not an aspirational feature list.
const INCLUDED = [
  "Painting project workspace",
  "Labor-cost calculations (computed automatically from your rates)",
  "Material and supply costs",
  "Overhead and additional job expenses",
  "Markup and margin calculations",
  "Professional, print-ready estimate builder",
  "Estimate-versus-actual job costing",
  "Reusable settings and business assumptions",
  "Unlimited local projects",
  "Print or PDF export",
  "Lifetime access",
  "All future updates to the workspace",
];
---

<section id="features" class="section-pad scroll-mt-16 border-t border-line">
  <div class="content-shell">
    <div data-animate class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Everything included for one payment.
      </h2>
    </div>

    <div data-animate class="card mx-auto mt-10 max-w-3xl p-6 sm:p-8">
      <ul class="grid grid-cols-1 gap-x-8 gap-y-3.5 sm:grid-cols-2">
        {
          INCLUDED.map((item) => (
            <li class="flex items-start gap-2.5 text-base text-ink">
              <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p data-animate class="mx-auto mt-6 max-w-2xl text-center text-base leading-relaxed text-ink">
      <strong class="font-semibold">Worth knowing:</strong> every project
      lives in your own browser's local storage, not a server — clearing
      your browser data erases it unless you've exported a backup, and
      moving to a new device means importing that backup there. Your
      one-time {PRICE.amount} payment still covers every future update to
      the workspace.
    </p>

    <div data-animate class="mt-8 flex justify-center">
      <a href="#pricing" class="btn btn-primary">{BUY_CTA_LABEL}</a>
    </div>
  </div>
</section>
