---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  updated: string;
}

const { title, description, eyebrow, heading, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" class="section-pad">
    <div class="content-shell max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {heading}
      </h1>
      <p class="mt-2 text-sm text-ink-soft">Last updated: {updated}</p>

      <div class="legal-content mt-10 space-y-8">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Minimal prose rules for hand-written legal content -- no typography
     plugin is installed elsewhere in this project, so this mirrors the
     spacing/scale already used by other long-form sections (FAQ, How it
     works) rather than introducing a new dependency for three pages. */
  .legal-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .legal-content :global(p),
  .legal-content :global(li) {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }
  .legal-content :global(ul) {
    list-style: disc;
  }
  .legal-content :global(ol) {
    list-style: decimal;
  }
  .legal-content :global(li + li) {
    margin-top: 0.375rem;
  }
  .legal-content :global(section > p + p) {
    margin-top: 0.75rem;
  }
  .legal-content :global(section > h2 + p),
  .legal-content :global(section > h2 + ul),
  .legal-content :global(section > h2 + ol) {
    margin-top: 0.625rem;
  }
  .legal-content :global(a) {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .legal-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-top: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }
  .legal-content :global(nav[aria-label="Sections"] a) {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
