---
import "../styles/global.css";
import { organizationSchema, websiteSchema, toLdJson } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to a real product image for social
   * previews (og:image/twitter:image) — defaults to an actual Overview
   * dashboard screenshot rather than leaving previews imageless. */
  image?: string;
  /** Extra JSON-LD objects specific to this page (Product, FAQPage, etc.),
   * rendered alongside the site-wide Organization/WebSite graph every page
   * already gets. */
  schema?: readonly unknown[];
  /** Root-relative override for the canonical URL, for a page that
   * intentionally renders the same content as another URL (e.g.
   * /painting-estimating-software mirrors /pricing) -- GSC's own "Alternate
   * page with proper canonical tag" pattern: the URL still resolves with
   * real content, but points Google at the one authoritative version
   * instead of being treated as separate duplicate content. Defaults to
   * this page's own path when omitted. */
  canonicalPath?: string;
}

const { title, description, image = "/guide/overview.webp", schema = [], canonicalPath } = Astro.props;
// Astro's own pathname carries a trailing slash for every non-root route
// (e.g. "/pricing/"), but every internal <a href> site-wide links to the
// no-trailing-slash form ("/pricing") -- a real mismatch between the
// canonical URL and the URL every internal link actually reinforces.
// Normalize to match the site's own linking convention rather than the
// other way around (changing every href instead would be a much larger,
// riskier change for the same result).
const normalizedPathname = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, "") : Astro.url.pathname;
const canonicalURL = new URL(canonicalPath ?? normalizedPathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const siteOrigin = Astro.site ? Astro.site.origin : canonicalURL.origin;
const jsonLd = [organizationSchema(siteOrigin), websiteSchema(siteOrigin), ...schema];

// Google Analytics (GA4). See privacy.astro's "Analytics" section for the
// real disclosure -- this is the one analytics platform actually
// connected. Production only, so local dev/preview traffic never pollutes
// real analytics data.
const GA_MEASUREMENT_ID = "G-SML9ZVEQ8E";
const analyticsEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <meta name="theme-color" content="#154D3B" />

    {jsonLd.map((entry) => (
      <script type="application/ld+json" set:html={toLdJson(entry)} />
    ))}

    {analyticsEnabled && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body class="font-sans antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />

    <script>
      // Gate the CSS entrance-animation classes behind a script-only
      // attribute so content is fully visible if JavaScript never runs.
      document.documentElement.setAttribute("data-animate-ready", "");

      import { shouldSkipEntranceAnimation, markVisible } from "../lib/reducedMotionVisibility";
      import { getStoredPayment } from "../lib/license";
      import { HEADER_CTA_UNLOCKED } from "../data/site";

      // Every "buy Pro" CTA site-wide (header, hero, closing) is tagged
      // data-pro-cta rather than each having its own copy of this check --
      // one stored license swaps all of them to "Go to app" at once. This
      // only reads a local flag (never verifies it against Dodo) purely to
      // pick which label/destination to show; /app's own ProGate is what
      // actually re-verifies access, so a stale or cleared local record
      // never grants anything here, it just shows the wrong button label
      // until the next real check.
      if (getStoredPayment()) {
        document.querySelectorAll<HTMLAnchorElement>("[data-pro-cta]").forEach((el) => {
          el.textContent = HEADER_CTA_UNLOCKED.label;
          el.href = HEADER_CTA_UNLOCKED.href;
        });
      }

      const animatedEls = document.querySelectorAll(
        "[data-animate], [data-animate-emphasis]"
      );

      if (shouldSkipEntranceAnimation((q) => window.matchMedia(q), "IntersectionObserver" in window)) {
        markVisible(animatedEls);
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                markVisible([entry.target]);
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
        );

        animatedEls.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
