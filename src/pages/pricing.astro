---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProHero from "../components/ProHero.astro";
import ProROI from "../components/ProROI.astro";
import ProProof from "../components/ProProof.astro";
import ProComparison from "../components/ProComparison.astro";
import ProQualification from "../components/ProQualification.astro";
import ProFeatures from "../components/ProFeatures.astro";
import ProNewProduct from "../components/ProNewProduct.astro";
import ProGuarantee from "../components/ProGuarantee.astro";
import LicenseActions from "../components/tools/LicenseActions.tsx";
import { PRICE, REFUND_GUARANTEE_DAYS, PRICING_AVAILABILITY_NOTE } from "../data/site";

const title = "Painting Estimate Pro | Know Your True Job Cost";
const description = "Painting Estimate Pro — one-time $79 payment, lifetime access. Calculate materials, labor, overhead and margin before you quote, then compare it to what the job actually cost.";

const FAQS = [
  {
    question: "What exactly do I receive?",
    answer: "Lifetime access to the Pro workspace: project estimating, Price Book Health, actual-cost review, and backup/restore, plus all future updates. You get a license key by email right after purchase — nothing to install.",
  },
  {
    question: "Is this a subscription?",
    answer: `No. Pro is a ${PRICE.amount} one-time payment with lifetime access — no recurring charges, ever.`,
  },
  {
    question: "Do I need to create an account?",
    answer: "No. There's no account or login — your license key unlocks the workspace directly in your browser.",
  },
  {
    question: "Where is my project data stored?",
    answer: "In your own browser's local storage, only — there's no server copy of your projects. Export a full backup any time from the Backup & Data tab.",
  },
  {
    question: "Can I use it on more than one device?",
    answer: "Yes — your license key works on any device or browser; paste it under \"Already purchased?\" to unlock it there too. Project data itself stays local to each browser, so use an exported backup to bring your projects along.",
  },
  {
    question: "Can I print or download estimates?",
    answer: "Yes — every estimate has a \"Print / Save as PDF\" button that produces a clean, customer-facing document with no cost or margin figures on it.",
  },
  {
    question: "Does it calculate markup and margin?",
    answer: "Yes — every estimate shows the estimated job cost, a suggested price at your target margin (or your own custom price), profit, and margin, before you send anything.",
  },
  {
    question: "Can it replace my current spreadsheet?",
    answer: "For painting estimating and job costing, yes — that's exactly what it replaces. It isn't a general-purpose spreadsheet or a business-management platform.",
  },
  {
    question: "Is this a CRM or scheduling system?",
    answer: "No. It doesn't handle scheduling, dispatch, payroll, or leads — see \"Built for painters who need better estimates\" above for exactly what it does and doesn't do.",
  },
  {
    question: "What happens if I clear my browser data or change devices?",
    answer: "Clearing your browser's site data permanently erases local project data unless you've exported a backup first — worth doing regularly from Backup & Data. Your license isn't affected either way: redeem your key again on any device, any time.",
  },
  {
    question: "Are future updates included?",
    answer: "Yes. Pro is a continuously updated web app under one license — there's no separate charge for future improvements to it.",
  },
  {
    question: `How does the ${REFUND_GUARANTEE_DAYS}-day guarantee work?`,
    answer: `Email us within ${REFUND_GUARANTEE_DAYS} days of your purchase date, from the address you paid with, and we'll issue a full refund. Your local project data is never deleted as part of a refund. See the Terms of Service for the complete policy.`,
  },
  {
    question: "What payment methods are accepted?",
    answer: "Checkout is handled by Dodo Payments, our payment processor — major credit and debit cards are accepted there.",
  },
  {
    question: "Is tax included in the displayed price?",
    answer: `${PRICE.amount} is the base price. Dodo Payments calculates any sales tax or VAT that applies to you at checkout, shown before you pay.`,
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <div class="content-shell pt-8">
      <div
        id="payment-failed-banner"
        hidden
        class="mx-auto max-w-3xl rounded-btn border border-bad-line bg-bad-soft px-5 py-4 text-sm text-bad"
      >
        <p id="payment-failed-message" class="font-semibold">That checkout didn't complete.</p>
        <p class="mt-1 text-ink-soft">If you were charged, contact us and we'll sort it out right away.</p>
      </div>
    </div>

    <ProHero />
    <ProROI />
    <ProProof />
    <ProComparison />
    <ProQualification />
    <ProFeatures />
    <ProNewProduct />
    <ProGuarantee />

    <section id="pricing" class="section-pad scroll-mt-16 border-t border-line">
      <div class="content-shell">
        <div data-animate class="card mx-auto max-w-2xl p-8 text-center sm:p-10">
          <h2 class="text-balance text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
            Protect the margin before the job begins.
          </h2>
          <p class="mx-auto mt-3 max-w-md text-lg text-ink-soft">
            Bring your materials, labor, overhead, margin, and actual job
            costs into one painting-specific estimating workflow.
          </p>

          <div class="mt-6 flex items-baseline justify-center gap-3">
            <span class="tabular-nums text-2xl font-medium text-ink-soft/70 line-through">{PRICE.originalAmount}</span>
            <span class="tabular-nums text-5xl font-semibold text-ink">{PRICE.amount}</span>
          </div>
          <p class="mt-2 text-sm font-medium text-ink-soft">{PRICE.caption} · No monthly subscription</p>

          <div class="mt-7 flex flex-col items-center gap-3">
            <LicenseActions client:load returnTo="/app" />
          </div>

          <p class="mt-6 text-sm text-ink-soft">
            {REFUND_GUARANTEE_DAYS}-day money-back guarantee · {PRICING_AVAILABILITY_NOTE}
          </p>
        </div>
      </div>
    </section>

    <section id="faq" class="section-pad scroll-mt-16 border-t border-line">
      <div class="content-shell max-w-3xl">
        <h2 data-animate class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          Questions before you buy
        </h2>

        <div data-animate class="mt-8 divide-y divide-line border-y border-line">
          {
            FAQS.map((faq) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
                  <span>{faq.question}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-ink-soft transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                </summary>
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">{faq.answer}</p>
              </details>
            ))
          }
        </div>

        <p data-animate class="mt-8 text-center text-sm text-ink-soft">
          Still have a question? <a href="/contact" class="text-link">Get in touch</a> — we're happy to help.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Above-the-fold failure notice: a checkout/recovery attempt that came
  // back non-success redirects here (see ProGate.tsx and app/welcome.astro)
  // with ?payment=failed&reason=<status> rather than only showing a small
  // note buried inside the /app paywall card.
  const REASON_COPY: Record<string, string> = {
    cancelled: "That checkout was cancelled — no charge was made.",
    refunded: "This purchase was refunded, so Pro access is no longer active. Contact support if that seems wrong.",
    not_configured: "Payments aren't fully set up yet — please try again shortly or contact us.",
    wrong_product: "That payment didn't match the Pro product — contact us and we'll sort it out.",
  };

  const params = new URLSearchParams(window.location.search);
  if (params.get('payment') === 'failed') {
    const reason = params.get('reason') || '';
    const banner = document.getElementById('payment-failed-banner');
    const message = document.getElementById('payment-failed-message');
    if (message) message.textContent = REASON_COPY[reason] ?? "That checkout didn't complete — if you were charged, contact us and we'll sort it out.";
    if (banner) banner.hidden = false;

    // Clean the URL so refreshing the page doesn't re-show the banner.
    params.delete('payment');
    params.delete('reason');
    const query = params.toString();
    window.history.replaceState({}, '', window.location.pathname + (query ? `?${query}` : ''));
  }
</script>
