---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import JobCostCalculator from "../../components/tools/JobCostCalculator.tsx";

const title = "Free Painting Job Cost Calculator | Painting Estimate Pro";
const description =
  "Enter materials, labor, and overhead to see an implied price for your target margin, or check the margin behind a price you already have in mind.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" class="section-pad">
    <div class="content-shell max-w-3xl">
      <p class="eyebrow">Free tool</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Painting job cost calculator
      </h1>
      <p class="mt-3 text-lg text-ink-soft">
        A complete answer, free — no account, no payment. Materials, labor,
        overhead, and your target margin, in one place.
      </p>
      <div class="mt-8">
        <JobCostCalculator client:load />
      </div>
      <p class="mt-6 text-sm text-ink-soft">
        Want reusable rates, multi-room projects, and Price Book Health?
        <a href="/#pricing" class="text-link">See the planned Pro offer.</a>
      </p>

      <div class="mt-10 border-t border-line pt-6">
        <h2 class="text-sm font-semibold text-ink">More free tools</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/free/interior-calculator" class="text-link">Interior painting calculator</a>
            <span class="text-ink-soft"> — estimate paint and labor for a single room.</span>
          </li>
          <li>
            <a href="/free/estimate-template" class="text-link">Painting estimate template</a>
            <span class="text-ink-soft"> — turn a job cost into a printable customer estimate.</span>
          </li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
