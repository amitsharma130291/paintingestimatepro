---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import EstimateTemplate from "../../components/tools/EstimateTemplate.tsx";

const title = "Free Painting Estimate Template | Painting Estimate Pro";
const description =
  "Build a clear, printable painting estimate with line items and an optional tax line — no account, no payment.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" class="section-pad">
    <div class="content-shell max-w-4xl">
      <p class="eyebrow">Free tool</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Painting estimate template
      </h1>
      <p class="mt-3 text-lg text-ink-soft">
        Add line items, review the total, and print or save as a PDF — a
        useful document without registering or paying.
      </p>
      <div class="mt-8">
        {/* client:only, not client:load: EstimateTemplate's initial state
            (newDraft()) bakes in a crypto.randomUUID()-based estimate
            number, which server-render and client-hydration would each
            generate independently -- a guaranteed React hydration mismatch
            on the very first render. client:only skips SSR for this
            component entirely, matching the same pattern already used for
            ProApp/ProGate (identical non-deterministic-initial-state
            situation). */}
        <EstimateTemplate client:only="react" />
      </div>
      <p class="mt-6 text-sm text-ink-soft">
        Want this generated automatically from a project you've already
        built? <a href="/#pricing" class="text-link">See the planned Pro offer.</a>
      </p>

      <div class="mt-10 border-t border-line pt-6">
        <h2 class="text-sm font-semibold text-ink">More free tools</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/free/job-cost-calculator" class="text-link">Painting job cost calculator</a>
            <span class="text-ink-soft"> — figure out the price and line items before you write them here.</span>
          </li>
          <li>
            <a href="/free/interior-calculator" class="text-link">Interior painting calculator</a>
            <span class="text-ink-soft"> — get the paint and labor numbers for a single room.</span>
          </li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
