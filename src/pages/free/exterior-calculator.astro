---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ExteriorCalculator from "../../components/tools/ExteriorCalculator.tsx";

const title = "Free Exterior Painting Cost Calculator | Painting Estimate Pro";
const description =
  "Exterior painting cost calculator: estimate paint gallons and total cost for your home's exterior — house dimensions, stories, doors, windows, and an optional labor estimate.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" class="section-pad">
    <div class="content-shell max-w-4xl">
      <p class="eyebrow">Free tool</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Exterior painting cost calculator
      </h1>
      <p class="mt-3 text-lg text-ink-soft">
        A whole-exterior estimator: house footprint, stories, doors and
        windows, one shared paint, an optional labor estimate. A
        rectangular-footprint model — for gables, dormers, or an unusual
        roofline, measure and total each wall section separately.
      </p>
      <div class="mt-8">
        <ExteriorCalculator client:load />
      </div>
      <p class="mt-6 text-sm text-ink-soft">
        Want reusable rates, multi-room interiors, and Price Book Health?
        <a href="/pricing" class="text-link">See Pro pricing and what's included.</a>
      </p>
      <p class="mt-2 text-sm text-ink-soft">
        Prefer one piece of software over separate calculators?
        <a href="/painting-estimating-software" class="text-link">See what painting estimating software should do.</a>
      </p>

      <div class="mt-10 border-t border-line pt-6">
        <h2 class="text-sm font-semibold text-ink">More free tools</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/free/interior-calculator" class="text-link">Interior painting cost calculator</a>
            <span class="text-ink-soft"> — estimate paint and labor for a single room.</span>
          </li>
          <li>
            <a href="/free/job-cost-calculator" class="text-link">Painting job cost calculator</a>
            <span class="text-ink-soft"> — price a whole job from materials, labor, and overhead.</span>
          </li>
          <li>
            <a href="/free/estimate-template" class="text-link">Painting estimate template</a>
            <span class="text-ink-soft"> — turn a job cost into a printable customer estimate.</span>
          </li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
