---
// Keeps this keyword-targeted URL ("painting estimating software") live
// and showing real content, while canonicalizing to /pricing -- the one
// authoritative sales page -- via BaseLayout's canonicalPath override.
// Content is the exact same PricingSalesPage component /pricing itself
// renders (not a separate page that can drift out of sync), matching
// Google's own "Alternate page with proper canonical tag" pattern: this
// URL still resolves with substantial content, but Google is told to
// index /pricing instead of treating this as separate duplicate content.
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingSalesPage, { PRICING_TITLE, PRICING_DESCRIPTION, PRICING_FAQS } from "../components/PricingSalesPage.astro";
import { PRICE } from "../data/site";
import { productSchema, faqPageSchema } from "../lib/schema";

const siteOrigin = Astro.site ? Astro.site.origin : new URL(Astro.url).origin;
const rawPrice = PRICE.amount.replace(/[^0-9.]/g, "");
const pricingUrl = `${siteOrigin}/pricing`;

const schema = [
  productSchema(siteOrigin, {
    url: pricingUrl,
    description: PRICING_DESCRIPTION,
    price: rawPrice,
    image: `${siteOrigin}/guide/overview.webp`,
  }),
  faqPageSchema(PRICING_FAQS),
];
---

<BaseLayout
  title={PRICING_TITLE}
  description={PRICING_DESCRIPTION}
  schema={schema}
  image="/guide/overview.webp"
  canonicalPath="/pricing"
>
  <PricingSalesPage />
</BaseLayout>
