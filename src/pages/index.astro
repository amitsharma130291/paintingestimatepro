---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import PriceBookHealth from "../components/PriceBookHealth.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Pricing from "../components/Pricing.astro";
import FreeTools from "../components/FreeTools.astro";
import FAQ from "../components/FAQ.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";

const title = "Painting Calculators & Estimating Software | Painting Estimate Pro";
const description =
  "See where painting quotes lose their margin, preview Painting Estimate Pro's job costing tools, and explore upcoming free painting calculators.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <Hero />
    <Problem />
    <PriceBookHealth />
    <HowItWorks />
    <Pricing />
    <FreeTools />
    <FAQ />
    <Closing />
  </main>
  <Footer />
</BaseLayout>
