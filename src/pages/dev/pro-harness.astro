---
// TEST-ONLY real-browser verification harness. Mounts the real ProApp
// component directly, seeded with synthetic (non-payment, non-account)
// local data, so this session's UX/print/keyboard/viewport checks can
// exercise the actual Pro UI in a real browser without needing to bypass
// or modify the production payment gate (src/components/tools/pro/ProGate.tsx),
// which this page never imports or touches. Never linked from any
// production page/nav.
//
// Excluded from production: if this somehow ships and is requested from a
// production build, it 404s instead of rendering anything.
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProApp from "../../components/tools/pro/ProApp.tsx";

const title = "Pro harness (dev only)";
---

<BaseLayout title={title} description="Internal dev-only verification harness. Not linked from any production page.">
  <main id="main-content" class="section-pad">
    <div class="content-shell">
      <p class="mb-4 rounded-btn border border-warn-line bg-warn-soft p-3 text-sm text-warn print:hidden">
        Dev-only verification harness — real ProApp component, synthetic local data, no payment/account code involved. Not part of the production site.
      </p>
      <ProApp client:only="react" />
    </div>
  </main>
</BaseLayout>

<script>
  // Seed a minimal, clearly-synthetic business settings + paint variant
  // record before ProApp's own load effect runs, so the harness opens
  // with a usable catalog instead of an empty-state prompt. This mirrors
  // exactly what a real user's first-run local data looks like -- no
  // fixture is copied from the test suite into production code.
  import("../../storage/db").then(async ({ openAppDb, STORES }) => {
    const db = await openAppDb();
    try {
      const existing = await db.get(STORES.businessSettings, "default-settings");
      if (!existing) {
        const now = new Date().toISOString();
        await db.put(STORES.businessSettings, {
          id: "default-settings", loadedHourlyRate: "32", overheadRatio: "0.15", targetMarginRatio: "0.35",
          defaultCoats: 2, defaultWasteRatio: "0.10", wallThroughput: "150", ceilingThroughput: "120",
          trimThroughput: "40", doorHoursPerSidePerCoat: "0.75", defaultTravelAmount: "0",
          defaultSuppliesAllowance: { mode: "none", amount: "0", ratio: "0" }, sampleAssumptionsConfirmed: true,
          createdAt: now, updatedAt: now,
        });
        await db.put(STORES.paintVariants, {
          id: "paint-1", name: "White", color: "white", sheen: "eggshell", pricePerGal: "42",
          coverageFt2PerGal: "350", purchaseIncrementGal: "1", createdAt: now, updatedAt: now,
        });
      }
    } finally {
      db.close();
    }
  });
</script>
