---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.tsx";

const title = "Contact | PaintingPricing Calculator";
const description = "Questions, feedback, or support — send a message and we'll reply soon.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" class="section-pad">
    <div class="content-shell max-w-xl">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Get in touch
      </h1>
      <p class="mt-3 text-lg text-ink-soft">
        Questions about a tool, a bug to report, or feedback on Pro — send a
        message below and we'll reply soon.
      </p>
      <div class="mt-8">
        <ContactForm client:load />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
