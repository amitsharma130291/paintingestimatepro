---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProGate from "../../components/tools/pro/ProGate.tsx";

const title = "Painting Estimate Pro — Workspace";
const description = "Business settings, catalog, projects, Price Book Health, and actuals — all stored locally in your browser.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" class="section-pad">
    <div class="content-shell">
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Pro workspace
      </h1>
      <div class="mt-8">
        <ProGate client:only="react" />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
