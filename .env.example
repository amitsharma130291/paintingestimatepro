# Painting Estimate Pro — environment variables for the Dodo Payments
# integration (src/lib/server/*, src/pages/api/**). All server-only; the
# browser never reads any of these directly, and never talks to Dodo's API
# directly either — only to this app's own /api/checkout and /api/license
# routes. Every value below is a placeholder — copy this file to `.env`
# and fill in your own real values from your Dodo dashboard. Never commit
# `.env` itself (already covered by .gitignore).

# From your Dodo dashboard -> API keys. Use a TEST-mode key while
# developing; only switch to a live key once you're ready to accept real
# charges.
DODO_PAYMENTS_API_KEY=

# "test_mode" or "live_mode" — must match the key above.
DODO_ENVIRONMENT=test_mode

# Create a one-time-payment product in the Dodo dashboard for "Painting
# Estimate Pro" ($99, matching src/data/site.ts's PRICE constant), then
# paste its product id here. Dodo's "License Keys" feature does NOT need
# to be enabled on this product — this app generates its own self-verifying
# key from the payment id, it never calls Dodo's native license-key API.
DODO_PRODUCT_ID_PRO=

# From your Dodo dashboard -> Webhooks, after creating an endpoint pointed
# at https://<your-deployed-domain>/api/webhooks/dodo listening for the
# payment.succeeded event. This is the signing secret Dodo gives you for
# that endpoint (verified via the `standardwebhooks` library) — it is NOT
# the same value as DODO_PAYMENTS_API_KEY.
DODO_PAYMENTS_WEBHOOK_KEY=

# A Gmail account + app password (not your regular Gmail password — create
# one at https://myaccount.google.com/apppasswords) used to send the
# purchase-confirmation/license-key email to customers and a copy to
# OWNER_EMAIL below. If left unset, checkout/redemption still work (the
# license key comes back in the API response and the browser unlocks
# immediately) but no email is ever sent — there is currently no other way
# for a customer to receive their key for later recovery.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where a copy of every order notification goes (your own inbox, doubling
# as the order ledger since there is no database). Also used as the
# customer email's reply-to address.
OWNER_EMAIL=
